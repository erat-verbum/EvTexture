# Environment variables for EvTexture service

# CUDA device to use (default: 0)
CUDA_VISIBLE_DEVICES=0

# Default output directory (used when user doesn't specify one)
# EVTEXTURE_OUTPUT_DIR=/tmp/evtexture/output

# Model download directory
# EVTEXTURE_MODEL_DIR=/models

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
